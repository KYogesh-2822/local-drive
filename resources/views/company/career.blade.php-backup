<script src="https://code.jquery.com/jquery-3.7.1.min.js" integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo=" crossorigin="anonymous"></script>
<script>

var selected_checkbox = [];

$('#selectJobCategory').change(function() {
    // Clear the array before updating
    selected_checkbox = [];
    
    // Iterate through each selected option
    $('#selectJobCategory').each(function() {
        selected_checkbox.push($(this).val());
    });
    
    var filter_topic = selected_checkbox.join(',');
    // $.ajax({
    // type: "get",
    // url: "{{route('company.selectJob')}}",
    // data: {id:filter_topic},
    //     success: function(response)
    //     {
    //         $('#selectedCategory').append(`${response.data.name} <i class="fa fa-times"></i>`);
    //     }
    // });
});

$("#job_filter").submit(function(e) {

e.preventDefault(); // avoid to execute the actual submit of the form.

var form = $(this);
var actionUrl = form.attr('action');
var actionMethod = form.attr('method');
$.ajax({
    type: "POST",
    url: actionUrl,
    data: form.serialize(), // serializes the form's elements.
    success: function(data){
    
     $('.appended_result').html('');
     $('.list-job-flush').html('');
     $('.appended_result').append(` <div class="card my-5" style="">
            <div class="card-header">
                <h6 class="pb-0">Search Results</h6>
                <span>${data.count} it Jobs</span>
            </div>
            <ul class="list-group list-group-flush list-job-flush">
            </ul>
        </div>
     `);
        $.each(data.data, function(k, v) {
            $('.list-job-flush').append(` <li class="list-group-item"> <a href="{{route('company.jobdis')}}/${v.id}">
                <h6 style="color: #002857;">${v.profile}</h6>
                <span>${v.location}</span><br>
                <span>Regular ${v.type}</span> </a>
            </li>
           `);
      
    });
        
    }
});

});
</script>
